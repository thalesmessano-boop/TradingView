# Copie este arquivo para ".env" e preencha com seus valores reais.
# NUNCA faça commit do arquivo ".env" (ele já está no .gitignore).

# Segredo compartilhado com o campo "webhookSecret" do indicador Pine Script.
# Serve para garantir que apenas o TradingView (que conhece o segredo) consiga
# disparar mensagens através deste servidor.
WEBHOOK_SECRET=troque-este-segredo

# Porta em que o servidor HTTP vai escutar.
PORT=8000

# Provedor de envio do WhatsApp: "twilio" ou "meta"
WHATSAPP_PROVIDER=twilio

# ---- Twilio (WhatsApp API / Sandbox) -----------------------------------
# https://www.twilio.com/docs/whatsapp/sandbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_TO=whatsapp:+55SEUNUMERO

# ---- Meta WhatsApp Cloud API --------------------------------------------
# https://developers.facebook.com/docs/whatsapp/cloud-api
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_TO_NUMBER=55SEUNUMERO
# Nome do template aprovado para mensagens iniciadas pelo negócio (fora da
# janela de 24h). Só é usado se WHATSAPP_PROVIDER=meta.
META_TEMPLATE_NAME=
META_TEMPLATE_LANG=pt_BR
